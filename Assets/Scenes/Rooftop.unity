--- !u!114 &2083779006
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2083779005}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 35ae91b84f4cc2340a0a4f423a8d3c03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  fadePanel: {fileID: 1171596516}
  dialogueBox: {fileID: 1933638509}
  dialogueText: {fileID: 1933638507}
  clickHint: {fileID: 1933638508}
  commonDialogueLines:
  - "\uAE40\uC11D\uADDC : ..."
  - "\uAE40\uC11D\uADDC : \uADF8\uB798, \uC625\uC0C1\uC5D0 \uB3C4\uB2EC\uD588\uAD6C\uB098"
  - "\uAE40\uC11D\uADDC : ... \uACE0\uC0DD\uD588\uB2E8\uB2E4"
  - "\uAD50\uC218\uB2D8..."
  - "\uB2E4\uB4E4... \uB2E4\uB4E4 \uC774\uC0C1\uD574\uC84C\uC5B4\uC694 \uD559\uAD50\uAC00..\uD559\uAD50\uAC00,
    \uC73C\uD751"
  dialogueSets:
  - lines:
    - "...\uC81C\uAC00 \uB2E4 \uC8FD\uC600\uC5B4\uC694"
    - "\uC6B0\uC9C4\uC774\uB3C4... \uBC94\uC11D\uC774\uB3C4 \uC724\uD558\uB2D8\uB3C4
      \uC81C\uAC00... \uC81C\uAC00 \uB2E4\uC8FD\uC600\uC5B4\uC694..."
    - "\uC800\uB791 \uAD50\uC218\uB2D8\uB9CC \uC0B4\uC544\uB0A8\uC558\uC5B4\uC694..."
    - "\uAE40\uC11D\uADDC: ...\uADF8\uB798 \uC6B0\uB9AC\uB9CC \uC0B4\uC544\uB0A8\uC558\uC9C0"
    - "\uAE40\uC11D\uADDC: \uB2E4\uB978\uC774\uB4E4\uC758 \uBAAB\uAE4C\uC9C0 \uC0B4\uC544\uB0B4\uBA74\uB3FC"
    - "\uAE40\uC11D\uADDC: ...\uADF8\uAC70\uBA74 \uB41C\uAC70\uC57C"
  - lines:
    - "\uC6B0\uC9C4\uC774\uAC00... \uC808 \uC704\uD574\uC11C \uCD1D\uC744 \uC92C\uC5B4\uC694..."
    - "\uC81C\uAC00, \uC81C\uAC00... \uC6B0\uC9C4\uC774\uB97C.... \uC6B0\uC9C4\uC774\uB97C
      \uC8FD\uC600\uC5B4\uC694..."
    - "\uAD50\uC218\uB2D8... \uC800\uB294 \uC5B4\uB5BB\uAC8C\uD574\uC57C \uD588\uC744\uAE4C\uC694"
    - "\uC73D...\uC73C\uD761..\uC544\uC544\uC544...."
    - "\uAE40\uC11D\uADDC: ... \uBAA8\uB450 \uC790\uB124\uB97C \uC6D0\uB9DD\uD558\uC9C0
      \uC54A\uC744\uAC70\uC57C"
    - "\uAE40\uC11D\uADDC: ...\uC0B4 \uC0AC\uB78C\uC740 \uC0B4\uC544\uC57C\uD558\uC9C0
      \uC54A\uACA0\uB098"
  - lines:
    - "\uAE40\uC11D\uADDC : ..."
    - "\uAD50\uC218\uB2D8... \uC81C\uAC00 \uBC94\uC11D\uC774\uB97C \uC8FD\uC600\uC5B4\uC694"
    - "...\uC6B0\uC9C4\uC774\uB294 \uCC28\uB9C8 \uB05D\uB0B4\uC8FC\uC9C0 \uBABB\uD588\uC5B4\uC694"
    - "\uAD34\uB85C\uC6B8 \uD150\uB370... \uAD50\uC218\uB2D8 \uC800\uB294 \uC5B4\uB5BB\uAC8C
      \uD574\uC57C\uD560\uAE4C\uC694 "
    - "\uC800\uB9CC \uC0B4\uC544\uAC00\uB294\uAC8C \uB9DE\uB294\uAC78\uAE4C\uC694...?"
    - "\uAE40\uC11D\uADDC: ...\uC0B4\uC544\uB0A8\uB294\uB2E4\uB294\uAC83\uC774 \uAC00\uC7A5
      \uBB34\uAC70\uC6B4\uC77C\uC774\uC9C0"
  - lines:
    - "\uC6B0\uC9C4\uC544... \uBC94\uC11D\uC544... \uC81C\uAC00 \uC6B0\uC9C4\uC774\uB791
      \uBC94\uC11D\uC774\uB97C..."
    - "\uD751...\uC73C\uC73D...\uC73C\uD750\uD751... \uAD50\uC218\uB2D8... \uC81C\uAC00,
      \uC81C\uAC00..."
    - "\uAE40\uC11D\uADDC: \uAD1C\uCC2E\uC544...\uAD1C\uCC2E\uC544... \uC790\uB124\uAC00
      \uD55C \uC77C\uC740 \uCD5C\uC120\uC774\uC5C8\uC744 \uBFD0\uC774\uC57C"
    - "\uAE40\uC11D\uADDC: ...\uADF8\uAC70\uBA74 \uCDA9\uBD84\uD574"
  - lines:
    - "\uC81C\uAC00 \uC724\uD558\uB2D8\uC744... \uC8FD\uC600\uC5B4\uC694"
    - "\uBD84\uBA85 \uC0AC\uB78C\uC774 \uC544\uB2C8\uC5C8\uC9C0\uB9CC... \uADF8\uB798\uB3C4
      \uAC19\uC774 \uC788\uC5C8\uB294\uB370..."
    - "\uAE40\uC11D\uADDC: \uC790\uB124\uB294 \uC0B4\uC544\uB0A8\uAE30 \uC704\uD574
      \uCD5C\uC120\uC744 \uB2E4\uD55C\uAC70\uB124"
    - "\uAE40\uC11D\uADDC: \uADF8 \uC774\uC0C1\uB3C4 \uADF8 \uC774\uD558\uB3C4 \uC544\uB2C8\uC57C"
  - lines:
    - "...\uBC94\uC11D\uC774\uB294 \uC5B4\uB518\uAC00\uC5D0\uC11C \uACC4\uC18D \uAE30\uC5B4\uB2E4\uB2C8\uACE0
      \uC788\uACA0\uC8E0...?"
    - "\uC81C\uAC00 \uBC94\uC11D\uC774\uC758 \uB9C8\uC9C0\uB9C9\uC744 \uB9DD\uCCD0\uBC84\uB9B0\uAC78\uAE4C\uC694"
    - "\uC8C4\uC1A1\uD574\uC694...\uC800 \uD63C\uC790\uB9CC... \uC6B0\uC9C4\uC774\uB791
      \uC724\uD558\uB2D8\uC740..."
    - "\uAE40\uC11D\uADDC: \uADF8\uB9CC, \uC790\uB124 \uD63C\uC790\uB9CC\uC774 \uC544\uB2C8\uC57C.
      \uB098\uB3C4 \uAC19\uC774\uB77C\uB124"
  - lines:
    - "\uC6B0\uC9C4\uC774\uB97C \uB05D\uB0B4\uC8FC\uC9C0 \uBABB\uD588\uC5B4\uC694...."
    - "\uBC94\uC11D\uC774\uB791 \uC724\uD558\uB2D8\uC740 \uC548\uC2DD\uC73C\uB85C
