      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: phases.Array.data[0].hintMessage
      value: "\uAE40\uC6B0\uC9C4 : ...\uC2DC\uAC04"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: phases.Array.data[1].hintMessage
      value: "...\uC2DC\uAC04"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: phases.Array.data[0].requiredFlag
      value: ClockEnd
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: phases.Array.data[1].requiredFlag
      value: ClockEnd
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: phases.Array.data[0].dialogueLines.Array.size
      value: 23
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: phases.Array.data[1].dialogueLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[0]'
      value: "\uC6B0\uC9C4..\uC544? \uB108 \uB9DE\uC9C0? \uB108..."
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[1]'
      value: "\uBAB8\uC774 \uC65C\uADF8\uB798... \uD53C\uD22C\uC131\uC774\uC796\uC544
        \uBB34\uC2A8 \uC77C \uC788\uB294\uAC70\uC57C?"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[2]'
      value: "\uAE40\uC6B0\uC9C4 : ..."
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[3]'
      value: "\uAE40\uC6B0\uC9C4 : \uC2DC\uAC04\uC774 \uC5C6\uC5B4"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[4]'
      value: "\uAE40\uC6B0\uC9C4 : \uBE68\uB9AC... \uC73D \uB3C4\uB9DD\uCCD0\uC57C
        \uB3FC \uC5EC\uAE30\uB3C4 \uC548\uC804\uD558\uC9C0 \uC54A\uC544"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[5]'
      value: "\uBB50? \uADF8\uAC8C \uBB34\uC2A8 \uC18C\uB9AC\uC57C?"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[6]'
      value: "\uAE40\uC6B0\uC9C4: \uB098\uAC00\uBCF4\uBA74 \uC54C\uAC70\uC57C \uC774\uC81C
        \uB124\uAC00 \uC54C\uB358 \uD559\uAD50\uB294 \uC5C6\uC5B4"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[7]'
      value: "\uC544\uBB34\uAC83\uB3C4 \uBAA8\uB974\uAC30\uC5B4..."
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[8]'
      value: "\uAE40\uC6B0\uC9C4 : 12\uC2DC\uC5D0\uC625\uC0C1\uC5D0 \uD5EC\uAE30\uAC00
        \uC640. \uADF8\uAC8C \uB9C8\uC9C0\uB9C9 \uD0C8\uCD9C \uAE30\uD68C\uC57C"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[9]'
      value: "\uAE40\uC6B0\uC9C4 : \uC218\uBB49,\uC774\uB4E4\uC744 \uC870\uC2EC\uD574
        \uADF8\uB9AC\uACE0 \uC0AC\uB78C\uB4E4\uB3C4..."
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[1].dialogueLines.Array.data[0]'
      value: "\uBE68\uB9AC \uC625\uC0C1\uC73C\uB85C\uAC00"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[1].dialogueLines.Array.data[1]'
      value: "\uC774\uAC74\uB0B4\uAC00\uC8FC\uC6B4\uC1E0\uD30C\uC774\uD504\uC57C"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[10]'
      value: "\uAE40\uC6B0\uC9C4 : \uC73C\uC73D..!"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[11]'
      value: "(\uAE40\uC6B0\uC9C4\uC774 \uBAB8\uC744 \uBD80\uC5EC\uC7A1\uC73C\uBA70
        \uD798\uACB9\uAC8C \uB9D0\uC744 \uC774\uC5B4\uAC04\uB2E4)"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[12]'
      value: "\uAE40\uC6B0\uC9C4 : ...\uB354 \uC124\uBA85 \uD560 \uC2DC\uAC04\uC774
        \uC5C6\uC5B4 \uBBF8\uC548\uD574"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[13]'
      value: "\uAE40\uC6B0\uC9C4 : 12\uC2DC, \uC625\uC0C1. \uB108\uB77C\uB3C4 \uD0C8\uCD9C\uD574...
        \uB09C \uC548\uB3FC"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[14]'
      value: "\uBB50..? \uB108\uB294...? \uB108\uB294! \uB2E4\uCCE4\uC796\uC544 
        \uC704\uD5D8\uD558\uB2E4\uBA70! \uAC19\uC774 \uAC00\uC57C\uD558\uC796\uC544..."
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[15]'
      value: "\uAE40\uC6B0\uC9C4 : ...\uB09C \uB2A6\uC5C8\uC5B4 "
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[16]'
      value: "\uAE40\uC6B0\uC9C4 : \uC911\uC5BC) \uB098\uB3C4 \uBC94\uC11D\uC774\uCC98\uB7FC
        \uB418\uACA0\uC9C0..."
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[17]'
      value: "\uBB50?"
      objectReference: {fileID: 0}
    - target: {fileID: 5693126212917706384, guid: e687aeaa143f7a644a8eb5c2d83bf004, type: 3}
      propertyPath: 'phases.Array.data[0].dialogueLines.Array.data[18]'
      value: "\uAE40\uC6B0\uC9C4 : \uC544\uB2C8\uC57C, \uC774\uAC70 \uB0B4\uAC00
